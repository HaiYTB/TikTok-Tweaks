# ==============================================================
# Telegram Bot Configuration
# Điền Token Bot Telegram lấy từ @BotFather vào bên dưới
# ==============================================================
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 3 Chế độ hoạt động linh hoạt (hybrid | downloader | checker)
# hybrid: Menu tương tác đầy đủ nút bấm (Mặc định)
# downloader: Tải ngay chất lượng gốc cao nhất (Instant Highest Quality)
# checker: Gửi ngay bảng phân tích chuyên sâu VQScore (Instant Analysis)
DEFAULT_MODE=hybrid

# Cài đặt chất lượng tải mặc định (original | standard | ask)
DEFAULT_QUALITY=ask

# Tự động tải video trực tiếp khi gửi link trong Group Chat (true | false)
GROUP_AUTO_DOWNLOAD=true

# Giới hạn kích thước file gửi qua Telegram Bot API (MB) - mặc định 512MB
MAX_FILE_SIZE_MB=512

# Thời gian chờ tối đa khi kết nối (giây)
REQUEST_TIMEOUT=30
